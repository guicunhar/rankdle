# Copie para .env no servidor de produção e preencha com valores de verdade.
#   cp .env.prod.example .env

# Senha do Postgres (use algo longo e aleatório, ex: `openssl rand -hex 24`)
POSTGRES_PASSWORD=troque-esta-senha

# Segredo pra assinar os tokens de login (ex: `openssl rand -hex 32`)
JWT_SECRET=troque-este-segredo
