# Copie para backend/.env.prod.local (fora do git) e preencha com a string
# de produção do Neon — usada pelos scripts scripts/publish_today.py e
# scripts/import_ranking.py para gravar direto no banco de produção.
#
#   cp .env.prod.local.example .env.prod.local
#
# Prefira a conexão DIRETA do Neon (sem "-pooler" no host): o pooler PgBouncer
# pode brigar com o SQLAlchemy/psycopg3. Troque o prefixo postgresql:// por
# postgresql+psycopg://.

RANKDLE_DATABASE_URL=postgresql+psycopg://neondb_owner:SENHA@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
